/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https:; style-src 'unsafe-inline'; img-src https: data:; connect-src https:; frame-src https:; frame-ancestors https://app.guildmate.workers.dev; base-uri 'none'; object-src 'none'; form-action 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()

/index.html
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
