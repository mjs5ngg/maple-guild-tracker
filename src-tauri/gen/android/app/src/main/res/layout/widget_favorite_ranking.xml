<?xml version="1.0" encoding="utf-8"?>
<!-- 대표 캐릭터를 포함한 즐겨찾기 오늘 경험치 순위를 고정 행 목록으로 표시합니다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/favorite_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/maple_widget_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/favorite_header"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="즐겨찾기 랭킹" android:textColor="#F7F8FA" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="TODAY · 획득 경험치" android:textColor="#FF8A4C" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <ImageView
            android:id="@+id/favorite_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/maple_widget_label_background"
            android:contentDescription="새로고침"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/maple_widget_refresh" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:background="#29313C" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="1">
        <ListView
            android:id="@+id/favorite_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:overScrollMode="never"
            android:scrollbars="vertical" />
        <LinearLayout android:id="@+id/favorite_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☆" android:textColor="#596575" android:textSize="29sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="즐겨찾기를 동기화해 주세요" android:textColor="#8C96A5" android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView android:id="@+id/favorite_updated" android:layout_width="match_parent" android:layout_height="18dp" android:gravity="end|bottom" android:maxLines="1" android:textColor="#657080" android:textSize="8sp" />
</LinearLayout>
