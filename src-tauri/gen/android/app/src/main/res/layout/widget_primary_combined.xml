<?xml version="1.0" encoding="utf-8"?>
<!-- 대표 캐릭터 카드와 최근 7일 성장표를 좌우로 합쳐 표시합니다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/primary_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/maple_widget_background"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="112dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingRight="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="20dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="22dp" android:layout_height="18dp" android:contentDescription="대표 캐릭터" android:scaleType="centerInside" android:src="@drawable/maple_widget_crown" />
            <TextView android:id="@+id/primary_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:layout_weight="1" android:autoSizeMaxTextSize="12sp" android:autoSizeMinTextSize="10sp" android:autoSizeStepGranularity="1sp" android:autoSizeTextType="uniform" android:gravity="start" android:maxLines="1" android:textColor="#D8DEE8" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="2dp" android:layout_weight="1">
            <ViewFlipper
                android:id="@+id/primary_avatar_flipper"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoStart="true"
                android:flipInterval="650">
                <ImageView android:id="@+id/primary_avatar_frame_0" android:layout_width="match_parent" android:layout_height="match_parent" android:adjustViewBounds="true" android:contentDescription="대표 캐릭터 대기 모션" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/primary_avatar_frame_1" android:layout_width="match_parent" android:layout_height="match_parent" android:adjustViewBounds="true" android:contentDescription="대표 캐릭터 대기 모션" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/primary_avatar_frame_2" android:layout_width="match_parent" android:layout_height="match_parent" android:adjustViewBounds="true" android:contentDescription="대표 캐릭터 대기 모션" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/primary_avatar_frame_3" android:layout_width="match_parent" android:layout_height="match_parent" android:adjustViewBounds="true" android:contentDescription="대표 캐릭터 대기 모션" android:scaleType="fitCenter" />
            </ViewFlipper>
        </FrameLayout>
        <TextView android:id="@+id/primary_rate" android:layout_width="match_parent" android:layout_height="21dp" android:gravity="center|bottom" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/primary_gain" android:layout_width="match_parent" android:layout_height="14dp" android:gravity="center" android:maxLines="1" android:textColor="#69D9B6" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>

    <TextView android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginRight="10dp" android:background="#313A46" />

    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="18dp" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:text="최근 7일 성장" android:textColor="#F7F8FA" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/weekly_day_1" style="@style/MapleWidgetWeeklyDay" />
        <TextView android:id="@+id/weekly_day_2" style="@style/MapleWidgetWeeklyDay" />
        <TextView android:id="@+id/weekly_day_3" style="@style/MapleWidgetWeeklyDay" />
        <TextView android:id="@+id/weekly_day_4" style="@style/MapleWidgetWeeklyDay" />
        <TextView android:id="@+id/weekly_day_5" style="@style/MapleWidgetWeeklyDay" />
        <TextView android:id="@+id/weekly_day_6" style="@style/MapleWidgetWeeklyDay" />
        <TextView android:id="@+id/weekly_day_7" style="@style/MapleWidgetWeeklyDay" />
        <TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" android:background="#313A46" />
        <TextView android:id="@+id/weekly_average" android:layout_width="match_parent" android:layout_height="14dp" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:textColor="#D6DAE1" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/weekly_estimate" android:layout_width="match_parent" android:layout_height="14dp" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="1" android:textColor="#FFAA79" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
