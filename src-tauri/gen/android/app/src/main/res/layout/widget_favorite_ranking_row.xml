<?xml version="1.0" encoding="utf-8"?>
<!-- 대형 위젯에서 스크롤되는 즐겨찾기 순위 한 행을 표시합니다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/favorite_row"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/maple_widget_row_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="9dp"
    android:paddingTop="5dp"
    android:paddingRight="10dp"
    android:paddingBottom="5dp">
    <TextView android:id="@+id/favorite_rank" style="@style/MapleWidgetRankNumber" />
    <ImageView android:id="@+id/favorite_avatar" style="@style/MapleWidgetAvatar" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/favorite_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#F4F6F9" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/favorite_primary" android:layout_width="wrap_content" android:layout_height="18dp" android:layout_marginStart="6dp" android:background="@drawable/maple_widget_label_background" android:gravity="center" android:paddingLeft="6dp" android:paddingRight="6dp" android:textColor="#FFAA79" android:textSize="8sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/favorite_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:textColor="#8994A3" android:textSize="9sp" />
    </LinearLayout>
    <TextView android:id="@+id/favorite_gain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:maxLines="1" android:textColor="#69D9B6" android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
