<?xml version="1.0" encoding="utf-8"?>
<!-- 가로·세로 2칸에서 대표 캐릭터의 현재 경험치와 오늘 성장을 표시합니다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/primary_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/maple_widget_background" android:gravity="center_horizontal" android:orientation="vertical">
    <TextView android:id="@+id/primary_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="#D8DEE8" android:textSize="12sp" android:textStyle="bold" />
    <ImageView android:id="@+id/primary_avatar" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:adjustViewBounds="true" android:contentDescription="대표 캐릭터" android:scaleType="fitCenter" />
    <TextView android:id="@+id/primary_rate" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="#FFF4ED" android:textSize="22sp" android:textStyle="bold" />
    <TextView android:id="@+id/primary_gain" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="#FF914D" android:textSize="11sp" android:textStyle="bold" />
</LinearLayout>
