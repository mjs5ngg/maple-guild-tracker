<?xml version="1.0" encoding="utf-8"?>
<!-- 가로·세로 2칸에서 대표 캐릭터의 현재 경험치와 오늘 성장을 표시합니다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/primary_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/maple_widget_background"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="24dp" android:layout_height="20dp" android:contentDescription="대표 캐릭터" android:scaleType="centerInside" android:src="@drawable/maple_widget_crown" />
        <TextView android:id="@+id/primary_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:autoSizeMaxTextSize="12sp" android:autoSizeMinTextSize="10sp" android:autoSizeStepGranularity="1sp" android:autoSizeTextType="uniform" android:gravity="end" android:maxLines="1" android:textColor="#D8DEE8" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="3dp" android:layout_weight="1">
        <ViewFlipper
            android:id="@+id/primary_avatar_flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:flipInterval="650">
            <ImageView android:id="@+id/primary_avatar_frame_0" android:layout_width="match_parent" android:layout_height="match_parent" android:adjustViewBounds="true" android:contentDescription="대표 캐릭터 대기 모션" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/primary_avatar_frame_1" android:layout_width="match_parent" android:layout_height="match_parent" android:adjustViewBounds="true" android:contentDescription="대표 캐릭터 대기 모션" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/primary_avatar_frame_2" android:layout_width="match_parent" android:layout_height="match_parent" android:adjustViewBounds="true" android:contentDescription="대표 캐릭터 대기 모션" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/primary_avatar_frame_3" android:layout_width="match_parent" android:layout_height="match_parent" android:adjustViewBounds="true" android:contentDescription="대표 캐릭터 대기 모션" android:scaleType="fitCenter" />
        </ViewFlipper>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="4dp" android:gravity="center" android:orientation="vertical">
        <TextView android:id="@+id/primary_rate" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/primary_gain" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:textColor="#69D9B6" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
