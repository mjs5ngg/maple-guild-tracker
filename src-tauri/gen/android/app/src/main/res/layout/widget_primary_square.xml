<?xml version="1.0" encoding="utf-8"?>
<!-- 가로·세로 2칸에서 대표 캐릭터의 현재 경험치와 오늘 성장을 표시합니다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/primary_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/maple_widget_background"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="wrap_content" android:layout_height="20dp" android:background="@drawable/maple_widget_label_background" android:gravity="center" android:paddingLeft="7dp" android:paddingRight="7dp" android:text="대표캐릭터" android:textColor="#FFAA79" android:textSize="7sp" android:textStyle="bold" />
        <TextView android:id="@+id/primary_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:layout_weight="1" android:ellipsize="end" android:gravity="end" android:maxLines="1" android:textColor="#D8DEE8" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="3dp" android:layout_weight="1">
        <ImageView android:id="@+id/primary_avatar" android:layout_width="match_parent" android:layout_height="match_parent" android:adjustViewBounds="true" android:contentDescription="대표 캐릭터" android:scaleType="fitCenter" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="4dp" android:gravity="center" android:orientation="vertical">
        <TextView android:id="@+id/primary_rate" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/primary_gain" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:textColor="#69D9B6" android:textSize="9sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
