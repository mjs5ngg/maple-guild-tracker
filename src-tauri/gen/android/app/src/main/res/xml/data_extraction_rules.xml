<?xml version="1.0" encoding="utf-8"?>
<!-- 로그인 세션·NEXON 서비스 키·기록이 클라우드 백업이나 기기 이전으로 복제되지 않게 모든 앱 데이터를 제외합니다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
