# 오래된 관측 원본을 검증된 압축 파일로 옮기고 DB 보존 범위를 유지합니다.
[Unit]
Description=Maple EXP observation retention
After=postgresql.service maple-exp-backup.service
Requires=postgresql.service

[Service]
Type=oneshot
User=mapledev
Group=mapledev
EnvironmentFile=/etc/maple-exp/server.env
Environment=MAPLE_OBSERVATION_ARCHIVE_DIR=/var/lib/maple-exp-observation-archive
Environment=MAPLE_OBSERVATION_ARCHIVE_DAYS=90
StateDirectory=maple-exp-observation-archive
StateDirectoryMode=0700
ExecStart=/usr/bin/bash /usr/local/lib/maple-exp/archive-observations-linux.sh
TimeoutStartSec=1h
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictSUIDSGID=true

