# 기존 수집 서버와 분리하여 읽기 전용 로컬 운영 화면을 유지합니다.
[Unit]
Description=Maple EXP local operations dashboard
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=mapledev
Group=mapledev
WorkingDirectory=/home/mapledev/maple-releases/20260913-edge-chase
EnvironmentFile=/etc/maple-exp/server.env
ExecStart=/home/mapledev/maple-releases/20260913-edge-chase/maple-exp-server --operations-only
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
