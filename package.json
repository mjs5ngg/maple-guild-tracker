{
  "name": "maple-guild-tracker",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run --exclude tests/visual/**",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "web:build": "node scripts/build-web.mjs",
    "web:server": "cargo run --manifest-path server/Cargo.toml",
    "web:direct": "powershell -NoProfile -Command \"$env:WEB_DIRECT='1'; npx vite --config vite.web.config.ts\"",
    "edge:typecheck": "tsc -p edge/tsconfig.json",
    "edge:migrate:local": "wrangler d1 migrations apply maple-exp-public --local --config edge/wrangler.jsonc",
    "edge:dev": "wrangler dev --config edge/wrangler.jsonc",
    "edge:deploy": "wrangler deploy --config edge/wrangler.jsonc",
    "deploy:edge": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-edge.ps1",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "package:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-android.ps1",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.12",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-autostart": "^2.0.0",
    "lucide-react": "^0.468.0",
    "pretendard": "^1.3.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
